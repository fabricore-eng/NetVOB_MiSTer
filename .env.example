# NetVOB_MiSTer — session secrets/config. Copy to `.env` (already gitignored) and fill in.
# An autonomous web session CANNOT obtain these on its own — stage them up front.
# Full rationale + pre-flight checklist: docs/session-bootstrap.md

# --- SuperStation One (the `ssh mister` hardware loop: load_core / Mount / screenshot) ---
MISTER_HOST=                 # LAN host/IP of the SuperStation One
MISTER_USER=root
MISTER_SSH_KEY=              # path to a private key the container can read, e.g. ~/.ssh/mister_ed25519

# --- Raspberry Pi 5 (provider service host) ---
PI_HOST=
PI_USER=
PI_SSH_KEY=

# --- x86 build box (runs Quartus Docker raetro/quartus:17.0; the container can't) ---
BUILDBOX_HOST=
BUILDBOX_USER=
BUILDBOX_SSH_KEY=

# --- Plex (PlexSource backend; absent → PlexSource runs as a stub) ---
PLEX_URL=                    # e.g. http://192.168.1.10:32400
PLEX_TOKEN=                  # X-Plex-Token (account-bound; not fetchable by the agent)

# --- Disc-ID metadata for DVD dumps (absent → sidecar/folder fallbacks) ---
TMDB_API_KEY=

# --- Staged DVD dumps (VOB/VIDEO_TS) on the Pi/build box; the service reads this path ---
DVD_DUMPS_DIR=/srv/netvob/dumps

# GitHub push credentials are provided in-session — do NOT put them here.
# SSH private keys: never commit keys; use a least-privilege key per host.
