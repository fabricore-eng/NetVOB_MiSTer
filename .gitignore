# Secrets / local config
.env
*.local

# Python (service/, tools/)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# FPGA build outputs (Quartus)
*.rbf
*.sof
output_files/
db/
incremental_db/
*.qws
*.rpt

# Simulation / verification artifacts (keep trace dirs single-writer; don't commit)
obj_dir/
sim_build/
traces/
sim_out/
*.vcd
*.fst

# Hardware-capture artifacts
screenshots/
filmstrips/

# Large test media (stage out-of-repo; see docs/session-bootstrap.md)
*.mpg
*.vob
*.iso
*.chd
*.m1v
*.m2v
tools/media/

# tools/ generated artifacts (scripts are durable; their output is not)
tools/**/out/
tools/**/*.png
tools/**/*.mpg
tools/**/*.vob
tools/**/*.m2v

# discid resolver: local metadata cache (per-machine, keyed by disc fingerprint)
tools/discid/cache.json
tools/discid/cache.json.tmp

# OS
.DS_Store

# Claude Code session scheduler lock
.claude/scheduled_tasks.lock

# Transient HW capture/render artifacts (keep committed evidence: sim_ref_*, hwfs_breakthrough/)
core/sim/artifacts/hwclip_*
core/sim/artifacts/vldprobe_hw/
core/sim/artifacts/*_decoded.png
