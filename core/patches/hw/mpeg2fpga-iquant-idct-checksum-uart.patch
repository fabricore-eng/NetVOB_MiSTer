diff --git a/rtl/mpeg2/mpeg2video.v b/rtl/mpeg2/mpeg2video.v
index 6662245..80bfe5b 100644
--- a/rtl/mpeg2/mpeg2video.v
+++ b/rtl/mpeg2/mpeg2video.v
@@ -57,7 +57,8 @@ module mpeg2video(clk, mem_clk, dot_clk, dot_ce,
              mem_req_rd_cmd, mem_req_rd_addr, mem_req_rd_dta, mem_req_rd_en, mem_req_rd_valid,                                    // clocked with mem_clk
              mem_res_wr_dta, mem_res_wr_en, mem_res_wr_almost_full,                                                               // clocked with mem_clk
              testpoint_dip, testpoint_dip_en, testpoint,
-             init_cnt_out, sync_rst_out, vbw_almost_full_out
+             init_cnt_out, sync_rst_out, vbw_almost_full_out,
+             iquant_chksum_out, idct_chksum_out, iquant_cnt_out, idct_cnt_out
 	     );
 
   input            clk;                     // clock. Typically a multiple of 27 Mhz as MPEG2 timestamps have a 27 Mhz resolution.
@@ -87,6 +88,10 @@ module mpeg2video(clk, mem_clk, dot_clk, dot_ce,
   output      [8:0]init_cnt_out;
   output           sync_rst_out;
   output           vbw_almost_full_out;
+  output     [31:0]iquant_chksum_out;       // HW-bisect: running 32-bit signed sum of iquant_level (valid-gated)
+  output     [31:0]idct_chksum_out;         // HW-bisect: running 32-bit signed sum of idct_data (valid-gated)
+  output     [31:0]iquant_cnt_out;          // HW-bisect: count of iquant_valid coefficients
+  output     [31:0]idct_cnt_out;            // HW-bisect: count of idct_valid samples
 
   /* register file access */
   input       [3:0]reg_addr;
@@ -549,6 +554,32 @@ module mpeg2video(clk, mem_clk, dot_clk, dot_ce,
   assign sync_rst_out = sync_rst;
   assign vbw_almost_full_out = vbw_wr_almost_full;
 
+  /* HW-bisect probe (573 plan): running 32-bit checksums of the iquant-OUT and
+   * IDCT-OUT coefficient streams, sign-extended + valid-gated, surfaced over UART.
+   * iquant_level [11:0] / idct_data [8:0] are declared WITHOUT `signed` here, so
+   * sign-extend explicitly; a naive add would zero-extend negatives -> desync vs sim.
+   * Same clk (clk_sys 27MHz) as uart_debug -> no CDC. Free-running; reset on stream reset. */
+  reg [31:0]iquant_chksum_sum; reg [31:0]iquant_chksum_cnt;
+  reg [31:0]idct_chksum_sum;   reg [31:0]idct_chksum_cnt;
+  always @(posedge clk)
+    if (~sync_rst) begin
+      iquant_chksum_sum <= 32'd0; iquant_chksum_cnt <= 32'd0;
+      idct_chksum_sum   <= 32'd0; idct_chksum_cnt   <= 32'd0;
+    end else begin
+      if (iquant_valid) begin
+        iquant_chksum_sum <= iquant_chksum_sum + {{20{iquant_level[11]}}, iquant_level};
+        iquant_chksum_cnt <= iquant_chksum_cnt + 32'd1;
+      end
+      if (idct_valid) begin
+        idct_chksum_sum <= idct_chksum_sum + {{23{idct_data[8]}}, idct_data};
+        idct_chksum_cnt <= idct_chksum_cnt + 32'd1;
+      end
+    end
+  assign iquant_chksum_out = iquant_chksum_sum;
+  assign idct_chksum_out   = idct_chksum_sum;
+  assign iquant_cnt_out    = iquant_chksum_cnt;
+  assign idct_cnt_out      = idct_chksum_cnt;
+
   /* reset signal synchronizers */
 
   reset reset (
