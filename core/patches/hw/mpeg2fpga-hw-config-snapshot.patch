-assign VGA_G  = core_g;
-assign VGA_B  = core_b;
-assign VGA_HS = core_h_sync;
-assign VGA_VS = core_v_sync;
-assign VGA_DE = core_pixel_en;
+assign VGA_R  = vga_r_r;
