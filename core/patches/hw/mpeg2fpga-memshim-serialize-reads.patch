+    // 2-state FSM otherwise advances on acceptance (not response), so it could issue a
+    // WRITE on top of an outstanding READ -> on real HW the HPS f2sdram wedges
+    // (waitrequest stuck) and a lost/misordered response permanently desyncs the
+    // response stream (observed: uart P=84 reads vs RP=83 responses, then hang).
+    reg read_pending;
+
     // Skid buffer — captures the FIFO word that appears 1 cycle after rd_en is
     // deasserted (standard mode FIFO 1-cycle latency).
     reg        saved_valid;
@@ -90,6 +98,7 @@ module mem_shim (
     always @(posedge clk) begin
         if (!rst_n) begin
             state          <= 0;
+            read_pending   <= 0;
             ram_read       <= 0;
             ram_write      <= 0;
             ram_address    <= 0;
@@ -109,6 +118,9 @@ module mem_shim (
             mem_res_wr_en <= ddr3_readdatavalid;
             if (ddr3_readdatavalid)
