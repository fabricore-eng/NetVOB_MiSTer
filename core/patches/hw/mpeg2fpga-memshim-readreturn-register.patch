--- /tmp/mem_shim.sv.working-baseline	2026-06-24
+++ core/MiSTer_MPEG2/rtl/mem_shim.sv	2026-06-24
@@ -61,6 +61,42 @@
     assign ddr3_writedata  = ram_writedata;
     assign ddr3_burstcnt   = 8'd1;
     assign ddr3_byteenable = 8'hFF;
+
+    // =========================================================================
+    // READ-RETURN INPUT PIPELINE (HW hold-margin fix 2026-06-24, "Option A") —
+    // placement-INDEPENDENT fix for the dead-read-return wedge.
+    // =========================================================================
+    // The HPS f2sdram read-return inputs (DOUT_READY/DOUT) were consumed
+    // COMBINATIONALLY and fanned out widely (response path, recovery, the
+    // outstanding/rsp counters, and the ADDR_ERR collision guards), so the
+    // bridge-pin -> first-fabric-register path was long and varied. That made it
+    // PLACEMENT-SENSITIVE: on a bad placement the read-return capture failed on
+    // silicon (raw DDRAM_DOUT_READY pulses VL=0 — reads accepted but NEVER
+    // answered -> the bus jams BUSY-forever; root-caused via the emu.sv DDRAM
+    // counter-probe). Registering these two inputs ONCE at the boundary gives the
+    // fitter a short, dedicated capture path it can place adjacent to the bridge
+    // interface and meet hold/setup robustly, decoupling all downstream logic
+    // from the bridge pin timing.
+    //
+    // Logic effect: a UNIFORM +1 clk cycle delay of the read RESPONSE only. The
+    // command/issue side (ram_read/ram_write/ram_address + the waitrequest-based
+    // acceptance) is untouched, so the bus stays fully pipelined and pacing is
+    // unchanged (outstanding_reads simply decrements 1 cycle later -> the
+    // READ_LIMIT throttle becomes marginally MORE conservative, never less).
+    // ddr3_waitrequest is intentionally LEFT combinational here: registering it
+    // changes command-acceptance timing (riskier) and the read-return is the
+    // proven-dead path — defer waitrequest to a second iteration if needed.
+    reg        rdv_q;       // registered ddr3_readdatavalid (DDRAM_DOUT_READY)
+    reg [63:0] rdd_q;       // registered ddr3_readdata      (DDRAM_DOUT)
+    always @(posedge clk) begin
+        if (!rst_n) begin
+            rdv_q <= 1'b0;
+            rdd_q <= 64'd0;
+        end else begin
+            rdv_q <= ddr3_readdatavalid;
+            rdd_q <= ddr3_readdata;
+        end
+    end
 
     // =========================================================================
     // 2-State FSM + Skid Buffer
@@ -93,7 +129,7 @@
     reg  [5:0]  outstanding_reads;   // reads accepted but not yet responded
     reg  [16:0] resp_timer;          // cycles since last response while reads are outstanding
     wire        read_accepted_now = state && ram_read && !ddr3_waitrequest;
-    wire        resp_timeout      = (outstanding_reads != 0) && !ddr3_readdatavalid && (&resp_timer);
+    wire        resp_timeout      = (outstanding_reads != 0) && !rdv_q && (&resp_timer);
 
     // The HPS f2sdram has an outstanding-READ throttle: HW lock-probe caught the bridge
     // LOCKING on a READ with 6 reads in flight (PC: lock_cmd=READ, outstanding=6). Bound
@@ -133,9 +169,9 @@
             // -----------------------------------------------------------------
             // Response Path (always active, independent of FSM state)
