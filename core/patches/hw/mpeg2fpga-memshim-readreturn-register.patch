                                 // drops the real read's data (-> corrupt reference -> garbage).
-                                if (!ddr3_readdatavalid) begin
+                                if (!rdv_q) begin
                                     mem_res_wr_dta <= 64'd0;
                                     mem_res_wr_en  <= 1'b1;
                                     saved_valid    <= 0;
@@ -242,7 +278,7 @@
                                 // mem_res_wr_en/dta for the REAL response — do not overwrite it with
