--- a/core/MiSTer_MPEG2/rtl/mem_shim.sv
+++ b/core/MiSTer_MPEG2/rtl/mem_shim.sv
@@ -127,7 +127,12 @@
     // (NOTE: do NOT add a read_pending/serialize hold here — stalling the bus deadlocks,
     //  because the f2sdram needs the pipeline moving to return responses.)
     reg  [5:0]  outstanding_reads;   // reads accepted but not yet responded
-    reg  [16:0] resp_timer;          // cycles since last response while reads are outstanding
+    reg  [13:0] resp_timer;          // cycles since last response while reads are outstanding
+                                     // 14-bit = 16383 cyc (~152us @108MHz): well above any real
+                                     // f2sdram read latency (incl. post-refresh spikes, ~<1024 cyc),
+                                     // so it drains a genuinely-dropped read fast (the WRITE-GATE now
+                                     // holds a write until this fires) without ever firing on a slow-
+                                     // but-live read (would double-respond -> desync).
     wire        read_accepted_now = state && ram_read && !ddr3_waitrequest;
     wire        resp_timeout      = (outstanding_reads != 0) && !rdv_q && (&resp_timer);
 
@@ -140,6 +145,18 @@
     wire next_is_read   = saved_valid ? (saved_cmd == CMD_READ)
                                       : (mem_req_rd_valid && (mem_req_rd_cmd == CMD_READ));
     wire read_throttled = next_is_read && (outstanding_reads >= READ_LIMIT);
+
+    // WRITE-GATE: never issue a write while a read is outstanding. The HW wedge
+    // (SignalTap-proven 2026-06-25) is a WRITE issued behind an outstanding READ
+    // whose response was dropped -> the f2sdram sticks BUSY forever. Holding the
+    // write until reads drain means the bridge never sees write-behind-read, so a
+    // dropped read degrades to a 1-read glitch (drained by resp_timeout) instead
+    // of a permanent wedge. Carve out the last-read-drain cycle so we don't stall
+    // the write one extra cycle when the sole outstanding read responds/recovers
+    // NOW. (A same-cycle read ACCEPT can't occur in the write branches: reads are
+    // accepted only in S_WAIT/state==1; writes are issued only in S_IDLE/state==0.)
+    wire reads_outstanding = (outstanding_reads != 0) &&
+                             !((outstanding_reads == 6'd1) && (rdv_q | resp_timeout));
 
     // Skid buffer — captures the FIFO word that appears 1 cycle after rd_en is
     // deasserted (standard mode FIFO 1-cycle latency).
@@ -173,9 +190,11 @@
             if (rdv_q)
                 mem_res_wr_dta <= rdd_q;
             else if (resp_timeout) begin
-                // A read response is genuinely lost (overdue by >2^17 clk_mem cycles,
+                // A read response is genuinely lost (overdue by >2^14 clk_mem cycles,
                 // far beyond any real f2sdram latency) -> synthesize one (0 data) so the
                 // decoder's response count re-syncs and the write it blocks can proceed.
+                // (Near-term liveness backstop; the correctness-preserving follow-on is to
+                //  RE-ISSUE the lost read instead of zero-filling -- no-mask doctrine.)
                 mem_res_wr_en  <= 1'b1;
                 mem_res_wr_dta <= 64'd0;
             end
@@ -214,6 +233,12 @@
                                 // Drop ADDR_ERR write — do not forward to DDR3
                                 saved_valid   <= 0;
                                 mem_req_rd_en <= !mem_res_wr_almost_full;
+                            end else if (reads_outstanding) begin
+                                // WRITE-GATE: hold the write while a read is outstanding.
+                                // Reuse the ADDR_ERR-guard hold idiom: keep the skid word,
+                                // don't pull the FIFO, don't advance state. ram_write stays 0.
+                                saved_valid   <= 1;
+                                mem_req_rd_en <= 0;
                             end else begin
                                 ram_write     <= 1;
                                 ram_address   <= {7'b0011000, saved_addr};
@@ -263,6 +288,11 @@
                             if (mem_req_rd_addr == ADDR_ERR) begin
                                 // Drop ADDR_ERR write — keep flowing
                                 mem_req_rd_en <= !mem_res_wr_almost_full;
+                            end else if (reads_outstanding) begin
+                                // WRITE-GATE (direct path): hold the write. Don't pull the
+                                // FIFO -> the same word re-presents next cycle (standard-mode
+                                // FIFO). Retries once outstanding reads drain to 0.
+                                mem_req_rd_en <= 0;
                             end else begin
                                 ram_write     <= 1;
                                 ram_address   <= {7'b0011000, mem_req_rd_addr};
