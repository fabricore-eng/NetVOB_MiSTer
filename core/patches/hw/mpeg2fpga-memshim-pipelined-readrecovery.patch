diff --git a/rtl/mem_shim.sv b/rtl/mem_shim.sv
index 33f3c2a..0e67e94 100644
--- a/rtl/mem_shim.sv
+++ b/rtl/mem_shim.sv
@@ -80,6 +80,31 @@ module mem_shim (
 
     reg state;
 
+    // DDR read-response RECOVERY (HW fix 2026-06-05). Keep the bus FULLY PIPELINED — the
+    // HPS f2sdram only returns read responses while pipelined (an isolated read starves;
+    // the decoder self-throttles via mem_req_almost_full so we don't over-issue). The HW
+    // wedge was a WRITE blocked forever by an outstanding READ whose response was LOST
+    // (uart P=84 reads vs RP=83 responses): the f2sdram holds waitrequest until that read
+    // completes. We can't tell which response was lost, so we RECOVER cause-agnostically:
+    // count outstanding reads; if NONE respond for far longer than any real latency,
+    // synthesize one response so the decoder re-syncs and the blocked write proceeds.
+    // (NOTE: do NOT add a read_pending/serialize hold here — stalling the bus deadlocks,
+    //  because the f2sdram needs the pipeline moving to return responses.)
+    reg  [5:0]  outstanding_reads;   // reads accepted but not yet responded
+    reg  [16:0] resp_timer;          // cycles since last response while reads are outstanding
+    wire        read_accepted_now = state && ram_read && !ddr3_waitrequest;
+    wire        resp_timeout      = (outstanding_reads != 0) && !ddr3_readdatavalid && (&resp_timer);
+
+    // The HPS f2sdram has an outstanding-READ throttle: HW lock-probe caught the bridge
+    // LOCKING on a READ with 6 reads in flight (PC: lock_cmd=READ, outstanding=6). Bound
+    // outstanding reads BELOW that so the bridge never throttles/locks. WRITES are not
+    // bounded by this; a genuinely-lost read still drains via resp_timeout, so a throttled
+    // read cannot deadlock (recovery guarantees forward progress).
+    localparam [5:0] READ_LIMIT = 6'd4;
+    wire next_is_read   = saved_valid ? (saved_cmd == CMD_READ)
+                                      : (mem_req_rd_valid && (mem_req_rd_cmd == CMD_READ));
+    wire read_throttled = next_is_read && (outstanding_reads >= READ_LIMIT);
+
     // Skid buffer — captures the FIFO word that appears 1 cycle after rd_en is
     // deasserted (standard mode FIFO 1-cycle latency).
     reg        saved_valid;
@@ -89,8 +114,10 @@ module mem_shim (
 
     always @(posedge clk) begin
         if (!rst_n) begin
-            state          <= 0;
-            ram_read       <= 0;
+            state             <= 0;
+            outstanding_reads <= 0;
+            resp_timer        <= 0;
+            ram_read          <= 0;
             ram_write      <= 0;
             ram_address    <= 0;
             ram_writedata  <= 0;
@@ -109,6 +136,27 @@ module mem_shim (
             mem_res_wr_en <= ddr3_readdatavalid;
             if (ddr3_readdatavalid)
                 mem_res_wr_dta <= ddr3_readdata;
+            else if (resp_timeout) begin
+                // A read response is genuinely lost (overdue by >2^17 clk_mem cycles,
+                // far beyond any real f2sdram latency) -> synthesize one (0 data) so the
+                // decoder's response count re-syncs and the write it blocks can proceed.
+                mem_res_wr_en  <= 1'b1;
+                mem_res_wr_dta <= 64'd0;
+            end
+
+            // Overdue-response timer: reset on any response or when nothing is outstanding.
+            if (ddr3_readdatavalid || outstanding_reads == 0)
+                resp_timer <= 0;
+            else if (!(&resp_timer))
+                resp_timer <= resp_timer + 1'b1;
+
+            // Outstanding-read count: +1 when a read is accepted, -1 on a real response OR
+            // a synthesized timeout-recovery. (Both events same cycle => net unchanged.)
+            case ({read_accepted_now, (ddr3_readdatavalid | resp_timeout)})
+                2'b10:   outstanding_reads <= outstanding_reads + 1'b1;
+                2'b01:   if (outstanding_reads != 0) outstanding_reads <= outstanding_reads - 1'b1;
+                default: ; // 2'b00 / 2'b11 -> unchanged
+            endcase
 
             // -----------------------------------------------------------------
             // Command Path FSM
@@ -117,7 +165,13 @@ module mem_shim (
                 // =============================================================
                 // S_IDLE: Process next command (skid buffer has priority)
                 // =============================================================
-                if (saved_valid && !mem_res_wr_almost_full) begin
+                if (read_throttled) begin
+                    // Too many reads in flight -> hold the next READ until they drain below
+                    // the bridge throttle (don't pull the FIFO, nothing is lost). Writes
+                    // behind it wait briefly (in-order); resp_timeout guarantees progress.
+                    mem_req_rd_en <= 1'b0;
+                end
+                else if (saved_valid && !mem_res_wr_almost_full) begin
                     case (saved_cmd)
                         CMD_WRITE: begin
                             if (saved_addr == ADDR_ERR) begin
@@ -135,11 +189,23 @@ module mem_shim (
                         end
                         CMD_READ: begin
                             if (saved_addr == ADDR_ERR) begin
-                                // Synthetic 0 response — do not forward to DDR3
-                                mem_res_wr_dta <= 64'd0;
-                                mem_res_wr_en  <= 1'b1;
-                                saved_valid    <= 0;
-                                mem_req_rd_en  <= !mem_res_wr_almost_full;
+                                // Synthetic 0 response — do not forward to DDR3.
+                                // COLLISION GUARD: if a real DDR3 readdatavalid lands this
+                                // cycle, the response path above already owns mem_res_wr_en/dta
+                                // for the REAL response. Do not overwrite it with the synthetic
+                                // 0, and do not consume the ADDR_ERR command — hold the skid word
+                                // (saved_valid stays 1, no FIFO pull) so the synthetic response is
+                                // re-issued next cycle. Without this, the same-cycle collision
+                                // drops the real read's data (-> corrupt reference -> garbage).
+                                if (!ddr3_readdatavalid) begin
+                                    mem_res_wr_dta <= 64'd0;
+                                    mem_res_wr_en  <= 1'b1;
+                                    saved_valid    <= 0;
+                                    mem_req_rd_en  <= !mem_res_wr_almost_full;
+                                end else begin
+                                    saved_valid    <= 1; // hold; retry next cycle
+                                    mem_req_rd_en  <= 0;
+                                end
                             end else begin
                                 ram_read      <= 1;
                                 ram_address   <= {7'b0011000, saved_addr};
@@ -171,10 +237,18 @@ module mem_shim (
                         end
                         CMD_READ: begin
                             if (mem_req_rd_addr == ADDR_ERR) begin
-                                // Synthetic 0 response — keep flowing
-                                mem_res_wr_dta <= 64'd0;
-                                mem_res_wr_en  <= 1'b1;
-                                mem_req_rd_en  <= !mem_res_wr_almost_full;
+                                // Synthetic 0 response — keep flowing. COLLISION GUARD: if a real
+                                // DDR3 readdatavalid lands this cycle, the response path above owns
+                                // mem_res_wr_en/dta for the REAL response — do not overwrite it with
+                                // the synthetic 0; stall the FIFO read so the same ADDR_ERR word is
+                                // re-presented and the synthetic response is issued next cycle.
+                                if (!ddr3_readdatavalid) begin
+                                    mem_res_wr_dta <= 64'd0;
+                                    mem_res_wr_en  <= 1'b1;
+                                    mem_req_rd_en  <= !mem_res_wr_almost_full;
+                                end else begin
+                                    mem_req_rd_en  <= 0; // stall; retry next cycle
+                                end
                             end else begin
                                 ram_read      <= 1;
                                 ram_address   <= {7'b0011000, mem_req_rd_addr};
@@ -195,6 +269,9 @@ module mem_shim (
                 // S_WAIT: Hold ram_read/write until bridge accepts
                 // =============================================================
                 if (!ddr3_waitrequest) begin
+                    // Command accepted. (A read accepted here is counted via
+                    // read_accepted_now in the response/recovery block above — pipelined,
+                    // not blocked.) Resume pulling the next command immediately.
                     ram_read      <= 0;
                     ram_write     <= 0;
                     state         <= 0;
@@ -235,6 +312,42 @@ module mem_shim (
         end
     end
 
+    // =========================================================================
+    // Bridge-LOCK probe (HW debug, observe-only — decode path untouched)
+    // Catches the moment the HPS f2sdram waitrequest sticks high while a command
+    // is asserted (the bridge stops accepting). Surfaced on the (previously unused)
+    // debug_read_pend_cycles -> uart PC field as a packed snapshot:
+    //   PC = {wedged(1), lock_cmd(2)={read,write}, lock_outstanding(6), recovery_count(7)}
+    // wedged (PC bit15 / PC>=0x8000) = bridge locked; lock_cmd tells read-vs-write at the
+    // lock; lock_outstanding = reads in flight then; recovery_count>0 = real dropped
+    // responses occurred (so the lock is drop-related) vs ==0 (a command-specific lock).
+    // =========================================================================
+    reg [11:0] wr_stall_cnt;
+    reg        wedged;
+    reg  [1:0] lock_cmd;
+    reg  [5:0] lock_outstanding;
+    reg  [6:0] recovery_count;
+    always @(posedge clk) begin
+        if (!rst_n) begin
+            wr_stall_cnt <= 0; wedged <= 0; lock_cmd <= 0; lock_outstanding <= 0; recovery_count <= 0;
+        end else begin
+            // consecutive cycles the bridge refuses an asserted command (waitrequest high)
+            if (state && (ram_read || ram_write) && ddr3_waitrequest) begin
+                if (!(&wr_stall_cnt)) wr_stall_cnt <= wr_stall_cnt + 1'b1;
+            end else begin
+                wr_stall_cnt <= 0;
+            end
+            // sustained refusal (>=256 cyc) = LOCK -> latch the condition, sticky
+            if (wr_stall_cnt >= 12'd256 && !wedged) begin
+                wedged           <= 1'b1;
+                lock_cmd         <= {ram_read, ram_write};
+                lock_outstanding <= outstanding_reads;
+            end
+            // count genuine lost responses recovered (resp_timeout synthesized one)
+            if (resp_timeout && !(&recovery_count)) recovery_count <= recovery_count + 1'b1;
+        end
+    end
+
     // =========================================================================
     // Debug telemetry
     // =========================================================================
@@ -258,6 +371,6 @@ module mem_shim (
     assign debug_rd_count         = rd_count;
     assign debug_wr_count         = wr_count;
     assign debug_rsp_count        = rsp_count;
-    assign debug_read_pend_cycles = 16'd0;
+    assign debug_read_pend_cycles = {wedged, lock_cmd, lock_outstanding, recovery_count};
 
 endmodule
