set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|mem_shim:mem_shim_inst|wr_stall_cnt[1]"
set_instance_assignment -name PRESERVE_REGISTER ON -to "emu:emu|mem_shim:mem_shim_inst|wr_stall_cnt[2]"
